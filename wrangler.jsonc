{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "venue-mind-api",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "venue-mind-production",
      "database_id": "965e47f1-c3c4-42e2-a44f-babcaf177081",
      "migrations_dir": "db/wrangler"
    }
  ],
  "vars": {
    "VENUEMIND_AUTH_MODE": "anonymous-demo",
    "VENUEMIND_APP_ORIGINS": "https://venue-mind-jet.vercel.app"
  },
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "venue-mind-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "venue-mind-staging",
          "database_id": "3ad04366-a3e4-4d1d-b320-a46e1d030a1c",
          "migrations_dir": "db/wrangler"
        }
      ],
      "vars": {
        "VENUEMIND_AUTH_MODE": "anonymous-demo",
        "VENUEMIND_APP_ORIGINS": "https://venue-mind-jet.vercel.app"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
