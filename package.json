{
  "name": "venue-mind",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:vercel",
    "build:vercel": "npm run generate:contracts && npm run generate:docs && npm run build:skills && npm run build:sdk && npm run build:mcp && npm run build:next",
    "build:next": "next build",
    "build:worker": "npm run generate:migrations && node scripts/build-worker.mjs",
    "build:cloudflare": "npm run generate:contracts && npm run build:worker",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy --env-file /dev/null",
    "deploy:cloudflare:staging": "npm run build:cloudflare && wrangler deploy --env staging --env-file /dev/null",
    "dev:cloudflare": "npm run build:worker && wrangler dev",
    "cf:typegen": "wrangler types --env-file /dev/null --env-interface CloudflareEnv worker-configuration.d.ts",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:skills": "node scripts/build-skills.mjs",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "generate:migrations": "node scripts/generate-db-migrations.mjs",
    "db:migrate": "node scripts/database-maintenance.mjs migrate",
    "db:verify": "node scripts/database-maintenance.mjs verify",
    "db:backup": "node scripts/database-maintenance.mjs backup",
    "db:restore": "node scripts/database-maintenance.mjs restore",
    "db:drill": "node scripts/database-maintenance.mjs drill",
    "generate:examples": "node scripts/generate-client-examples.mjs",
    "generate:guides": "node scripts/generate-contributor-guides.mjs",
    "generate:sdk-types": "node scripts/generate-sdk-types.mjs",
    "generate:docs": "npm run generate:examples && npm run generate:guides && node scripts/generate-license-notices.mjs && node scripts/generate-agent-docs.mjs && node scripts/generate-site-metadata.mjs",
    "check:generated": "node scripts/check-generated-drift.mjs",
    "start": "next start",
    "preview": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker && npm run typecheck:mcp && npm run typecheck:sdk",
    "typecheck:app": "tsc --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "typecheck:mcp": "tsc -p packages/mcp-server/tsconfig.json --noEmit",
    "typecheck:sdk": "tsc -p packages/sdk/tsconfig.json --noEmit",
    "check:typesafety": "npm run typecheck && npm run lint",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "check:performance": "node scripts/benchmark-performance.mjs --target=large --iterations=3",
    "test": "npm run build && npm run build:worker && node --test tests/*.test.mjs",
    "test:mcp": "npm run build:mcp && node --test tests/mcp-server.test.mjs",
    "test:sdk": "npm run build:sdk && node --test tests/sdk-*.test.mjs",
    "test:domain": "node --test tests/venue-planner.test.mjs",
    "test:worker": "npm run build:worker && node --test tests/worker-api.test.mjs",
    "test:skills": "npm run build:skills && node --test tests/skills.test.mjs",
    "test:tutorials": "node scripts/verify-tutorials.mjs",
    "test:browser": "node --test tests/browser-platform.test.mjs tests/responsive-browser-ui.test.mjs",
    "test:frontend-platform": "npm run build:worker && node --test tests/frontend-platform-verifier.test.mjs tests/next-route-boundaries.test.mjs tests/next-route-css.test.mjs tests/studio-code-splitting.test.mjs tests/webmcp-lifecycle.test.mjs tests/project-store.test.mjs tests/collaboration.test.mjs tests/studio-accessibility.test.mjs tests/responsive-browser-ui.test.mjs tests/visual-system.test.mjs",
    "verify:frontend-platform": "npm run build:next && node scripts/verify-next-platform.mjs && npm run test:frontend-platform",
    "verify:hosting": "node scripts/verify-hosting-config.mjs && node --test tests/hosting-config.test.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:production:write": "node scripts/smoke-production.mjs --write",
    "generate:release": "node scripts/generate-release-artifacts.mjs",
    "check:release": "node scripts/generate-release-artifacts.mjs --check && node scripts/verify-release.mjs",
    "test:release": "node --test tests/release-system.test.mjs tests/interchange.test.mjs tests/database-migrations.test.mjs",
    "verify:release": "npm run check:release && npm run test:release",
    "validate:skills": "node scripts/validate-skills.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.38.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "esbuild": "^0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "json-schema-to-typescript": "16.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.127.1"
  }
}
